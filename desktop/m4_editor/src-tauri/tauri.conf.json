{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screendeck",
  "version": "0.4.0",
  "identifier": "com.screendeck.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Screendeck",
      "width": 1440,
      "height": 900,
      "minWidth": 1060,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false,
      "backgroundColor": "#101114"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Configure and synchronize Screendeck projects",
    "longDescription": "A lightweight editor for Screendeck profiles, pages, icons and HID macros.",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
